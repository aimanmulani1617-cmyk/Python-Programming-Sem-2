# Movie Ticket Eligibility Program

# Input: age of the person
age = int(input("Enter your age: "))

# Control structure to check eligibility
if age >= 18:
    print("You are eligible to buy a movie ticket.")
else:
    print("Sorry, you are not eligible. Age must be 18 or above.")
