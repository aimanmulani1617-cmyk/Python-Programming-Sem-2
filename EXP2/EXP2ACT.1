#include <stdio.h>
int main() {
int speed;

    printf("Enter your driving speed (km/h): ");
    scanf("%d", &speed);

    if (speed > 60) {
        printf("You are overspeeding! Fine imposed.\n");
    } else {
        printf("You are driving within the speed limit.\n");
    }

    return 0;
}
