# A bank gives loan approval only if salary ≥ ₹25,000. Print Approved/Rejected.
"""
Created on Thu Apr 16 21:49:44 2026

@author: Aiman
"""
# Program to check loan approval based on salary

salary = int(input("Enter your salary: "))

if salary >= 25000:
    print("Approved")
else:
    print("Rejected")

