# Write a Python program using the date time module to print the current date and weekday

"""
Created on Mon Apr 20 14:50:10 2026

@author: Aiman
"""

import datetime
# Get current date and time
now = datetime.datetime.now()
# Print current date
print("Current Date:", now.strftime("%Y-%m-%d"))
# Print current time
print("Current Time:", now.strftime("%H:%M:%S"))

# Print current weekday
print("Weekday:", now.strftime("%A"))



