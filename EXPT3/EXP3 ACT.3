# Multiplication tables from 1 to 10
for i in range(1, 11):  # Loop for numbers 1 to 10
    print(f"\nMultiplication Table for {i}")
    for j in range(1, 11):  # Loop for multiplying each number up to 10
        print(f"{i} x {j} = {i * j}")

